#!/bin/sh

# Symphony release env overrides — sourced by rel/symphony/releases/<vsn>/env.sh
# before BEAM start.

# 1) UTF-8 locale required by yamerl (otherwise "invalid_unicode" on non-ASCII
#    bytes in WORKFLOW.md). plist EnvironmentVariables LANG is not propagated
#    reliably to release VM, so force it here.
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# 2) Disable Erlang distribution. Symphony is single-node — no remote shell,
#    no clustering. Multiple chains starting in parallel would otherwise hit
#    "name in use by another Erlang node" on the shared `symphony` sname.
export RELEASE_DISTRIBUTION=none
